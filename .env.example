# ── MongoDB Atlas Connection String ─────────────────────────────────────────
# Replace <username>, <password>, and <cluster-url> with your actual values.
# Get this from: MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/employeeDB?retryWrites=true&w=majority

# ── Server Port ──────────────────────────────────────────────────────────────
# The port on which the Express server will listen (default: 5000)
PORT=5000
